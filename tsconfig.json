{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2023"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["server/src/**/*.ts", "server/vendor/**/*.ts", "plugins/*/src/**/*.ts", "mcp/**/*.ts"]
}
