{
  "name": "comfyui-imagine",
  "version": "0.1.1",
  "private": true,
  "description": "A local studio for ComfyUI: a chat that turns a sentence into the right graph, a job queue, a gallery and ready-made image and video recipes.",
  "license": "MIT",
  "homepage": "https://github.com/BTekV4/comfyui-imagine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BTekV4/comfyui-imagine.git"
  },
  "bugs": {
    "url": "https://github.com/BTekV4/comfyui-imagine/issues"
  },
  "type": "module",
  "scripts": {
    "build:server": "node scripts/build.mjs server",
    "build:web": "vite build web",
    "build": "node scripts/build.mjs && vite build web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --env-file=test/test.env --experimental-transform-types --test test/*.test.ts",
    "build:plugins": "node scripts/build.mjs plugins",
    "build:mcp": "node scripts/build.mjs mcp",
    "start": "node dist/server.mjs",
    "release:tarball": "bash scripts/release-tarball.sh"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24"
  }
}
