node_modules/
dist/
*.log
*.map

# Secrets and deployment data: never in the repo
.env
.env.*
imagine.env
config.yaml
data/
password.json
cookie-secret
*.pem
*.key

# Backup copies made by hand or by the deploy (file.bak-<date>): never in the
# repo, and deploy.sh must not copy them into the published plugins
*.bak-*

# Backup graphs / local test runs
workflows/*.bak*
workflows/*.before-restore-*
workflows/test-*/

# The real persona does not travel: only the example
persona/*.json
!persona/example.json

# Bundles of the TypeScript plugins: built by `npm run build:plugins` (and deploy)
plugins/*/index.mjs
!plugins/telegram/index.mjs

# Python bytecode of the ComfyUI pack
__pycache__/

# The tarball a release ships, built by scripts/release-tarball.sh
release/

# The staged tree electron-builder packages (scripts/package-electron.sh)
build/
